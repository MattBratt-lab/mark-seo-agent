# --- Action required ---
# Fill in FIRECRAWL_API_KEY (researcher / Firecrawl search) and GOOGLE_API_KEY (Gemini writer).
# Optional: use GEMINI_API_KEY instead of GOOGLE_API_KEY for the same Google AI key.
# Save as UTF-8 (not UTF-16). One line per KEY=value; NUL bytes in values will crash load_dotenv.

# Gemini / Google GenAI (Writer — LangChain uses GOOGLE_API_KEY or GEMINI_API_KEY)
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Use gemini-2.5-flash for free tier; set gemini-3-pro-preview only if your project has quota.
GEMINI_MODEL=gemini-2.5-flash

# Ollama / Google Gemma 4 (Parser) — tag must match `ollama list` (e.g. gemma4 or gemma4:e4b)
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma4:e4b

# Firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Auditor (live site scrape vs research)
AUDIT_SITE_URL=https://www.dandbgaragedoors.com/

# HITL notifications (optional; at least one helps)
# Used by agents/notifier.py (HITL) and agents/governance_bot.py (review alerts).
SEO_DISCORD_AGENT_NAME=Mark
DISCORD_WEBHOOK_URL=
# Discord *bot* token for button approvals (agents/discord_hitl_bot.py) — not the webhook secret.
DISCORD_BOT_TOKEN=
# Channel ID where ✅/❌ approval buttons are sent; defaults to 1495190959405924574 when empty.
DISCORD_HITL_CHANNEL_ID=1495190959405924574
# Optional: guild id for fast slash-command sync; leave empty for global sync (slower).
DISCORD_HITL_GUILD_ID=
# Comma-separated user IDs allowed to approve/reject (optional; empty = Manage Server permission).
DISCORD_HITL_APPROVER_USER_IDS=
# Comma-separated role IDs allowed (optional; enables Server Members intent on the bot).
DISCORD_HITL_APPROVER_ROLE_IDS=
HITL_NOTIFY_EMAIL=

# Seconds to wait for Discord approval before auto-skipping (default: 3600 = 1 hour)
HITL_TIMEOUT_SECONDS=3600

# Auto-approve publish without human review (set true to skip Discord approval entirely)
AUTO_APPROVE_HITL=false

# Local clone of the static Pages site (optional). Used by publish_existing.py and
# agents/orchestrator.py to run `wrangler pages deploy` after GitHub commits.
# Example (this machine): /Users/mateo/projetcs/DandBgaragedoors-main
SITE_DIR=

# Cloudflare publish worker (optional until deployed)
PUBLISH_WORKER_URL=
# Same value as Worker secret AUTH_TOKEN (wrangler secret put AUTH_TOKEN)
PUBLISH_AUTH_TOKEN=

# Hub pages: GitHub path prefix (default guides → guides/{slug}/index.html)
HUB_PUBLISH_TARGET_PREFIX=guides

# LangGraph: set to 1 to use in-memory checkpointer (resume_hitl will NOT work across runs)
LANGGRAPH_MEMORY_CHECKPOINTER=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
