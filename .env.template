# --- Action required ---
# Fill in FIRECRAWL_API_KEY (researcher / Firecrawl search) and GOOGLE_API_KEY (Gemini writer).
# Optional: use GEMINI_API_KEY instead of GOOGLE_API_KEY for the same Google AI key.
# Save as UTF-8 (not UTF-16). One line per KEY=value; NUL bytes in values will crash load_dotenv.

# Gemini / Google GenAI (Writer — LangChain uses GOOGLE_API_KEY or GEMINI_API_KEY)
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Use gemini-2.5-flash for free tier; set gemini-3-pro-preview only if your project has quota.
GEMINI_MODEL=gemini-2.5-flash

# Ollama / Google Gemma 4 (Parser) — tag must match `ollama list` (e.g. gemma4 or gemma4:e4b)
OLLAMA_HOST=http://localhost:11434
GEMMA_MODEL=gemma4:e4b

# Firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# Auditor (live site scrape vs research)
AUDIT_SITE_URL=https://www.dandbgaragedoors.com/

# HITL notifications (optional; at least one helps)
DISCORD_WEBHOOK_URL=
HITL_NOTIFY_EMAIL=

# Auto-approve publish after writer (set false to pause for resume_hitl.py)
AUTO_APPROVE_HITL=true

# Cloudflare publish worker (optional until deployed)
PUBLISH_WORKER_URL=
# Same value as Worker secret AUTH_TOKEN (wrangler secret put AUTH_TOKEN)
PUBLISH_AUTH_TOKEN=

# LangGraph: set to 1 to use in-memory checkpointer (resume_hitl will NOT work across runs)
LANGGRAPH_MEMORY_CHECKPOINTER=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
